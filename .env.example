# Copy to .env for local development; never commit real secrets.
# Create a new Reddit app credential pair and set these values locally/on the server.
REDDIT_CLIENT_ID=replace_with_reddit_client_id
REDDIT_CLIENT_SECRET=replace_with_reddit_client_secret
REDDIT_USER_AGENT=Equinox-wellness-demo

# Generate a long random secret for signed Flask sessions.
EQUINOX_SECRET_KEY=replace_with_a_long_random_secret

# Demo-only shared password; replace with real authentication before production use.
EQUINOX_DEMO_PASSWORD=replace_with_a_strong_demo_password

# Set to production on the server so startup fails closed without required secrets.
EQUINOX_ENV=development
